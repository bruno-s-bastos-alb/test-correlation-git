package pt.ptinovacao.alarmmgr.eventcorrelation.ptc.regrassoltas.pack106

import com.alticelabs.alarmmgr.commons.correlation.model.NotifAlarmCorrelationEvent;
import com.alticelabs.alarmmgr.correlation.engine.session.model.helper.GenericHelper;
import pt.ptinovacao.alarmmgr.common.shared.fm.monitor.Link;
import pt.ptinovacao.alarmmgr.common.shared.fm.monitor.PerceivedSeverity;
import java.util.logging.Logger;
import java.util.*;
import java.lang.*;

import java.util.regex.Pattern;
import java.util.regex.Matcher;

global GenericHelper helper;
global Logger logger;

declare NotifAlarmCorrelationEvent
@role( event )
end

function String extract(String regex, String value) {
    Pattern ptn = Pattern.compile(regex);
    if (value != null) {
        Matcher m = ptn.matcher(value);
        if (m.find()) {
            return m.group(1);
        }
    }

    return "";
}

function Long toLong(Object val){
    Number num;

    if (val instanceof String)
        num = Long.parseLong((String)val);
    else {
        num = (Number) val;
    }

    return num != null ? num.longValue(): null;
}

function boolean containsLinkUrl(List links, Link expectedLink) {
    if (links == null || expectedLink == null || expectedLink.getUrl() == null) {
        return false;
    }

    for (Object value : links) {
        if (value instanceof Link) {
            Link link = (Link) value;
            if (expectedLink.getUrl().equals(link.getUrl())
                    && (expectedLink.getAttribute() == null
                        || expectedLink.getAttribute().equals(link.getAttribute()))
                    && (expectedLink.getAlias() == null
                        || expectedLink.getAlias().equals(link.getAlias()))) {
                return true;
            }
        }
    }

    return false;
}

function void appendLinks(NotifAlarmCorrelationEvent target, Object values) {
    if (target == null || values == null) {
        return;
    }

    if (values instanceof Link) {
        target.addLink((Link) values);
        return;
    }

    if (values instanceof Iterable) {
        for (Object value : (Iterable) values) {
            appendLinks(target, value);
        }
        return;
    }

    if (values instanceof Link[]) {
        for (Link value : (Link[]) values) {
            appendLinks(target, value);
        }
        return;
    }

    throw new IllegalArgumentException("Expected a Link or an iterable of Links");
}


function Map getAlarmUniqueKeys(List events){
    Map<String, String> result = new HashMap<>();

    if (events != null) {
        for (NotifAlarmCorrelationEvent event : (List<NotifAlarmCorrelationEvent>)events) {
            result.put(event.getAlarmUniqueKey(), "");
        }
    }

    return result;
}

// Pack "Encoder HE/HOR"
rule "Automatic Clean_106"
salience (-100)
no-loop
when
    CLEAR: NotifAlarmCorrelationEvent(
        ruleID == getPackId(),
        perceivedSeverity == PerceivedSeverity.CLEARED
    )

    EVENTS_ARRAY: ArrayList(  ) from collect (
        NotifAlarmCorrelationEvent(
            ruleID == getPackId(),
            alarmUniqueKey == CLEAR.alarmUniqueKey,
            this before CLEAR
        )
    )
then
    retract(CLEAR);
    for (NotifAlarmCorrelationEvent a: (List<NotifAlarmCorrelationEvent>)EVENTS_ARRAY ) {
        retract(a);
    }
end
rule "SOURCE_VIDEO_UNDERFLOW (Start) _106"
no-loop
when
       Primeiro_Alarm_Encoder: NotifAlarmCorrelationEvent(
          specificProblem != null, specificProblem.contains("SOURCE_VIDEO_UNDERFLOW"),
          managedObjectClass == "CANAL",
          managedObjectInstance != null, managedObjectInstance.matches("ENCODER (.*\\[[0-9:]+\\].*)"
),
          getStringFromVariableAttributes("sol_ne") != null,
!getStringFromVariableAttributes("sol_ne")
.isEmpty(),
          perceivedSeverity != PerceivedSeverity.CLEARED
       )

       not NotifAlarmCorrelationEvent(
          alarmUniqueKey == Primeiro_Alarm_Encoder.alarmUniqueKey,
          perceivedSeverity == PerceivedSeverity.CLEARED,
          this after Primeiro_Alarm_Encoder
       )

       not NotifAlarmCorrelationEvent(
          alarmUniqueKey == Primeiro_Alarm_Encoder.alarmUniqueKey,
          perceivedSeverity != PerceivedSeverity.CLEARED,
          this before Primeiro_Alarm_Encoder
       )

       segundo_Alarm_Encoder: NotifAlarmCorrelationEvent(
          specificProblem != null, specificProblem.contains("SOURCE_VIDEO_UNDERFLOW"),
          managedObjectClass == "CANAL",
          managedObjectInstance != null, managedObjectInstance.matches("ENCODER (.*\\[[0-9:]+\\].*)"
),
          Primeiro_Alarm_Encoder.getStringFromVariableAttributes("sol_ne") != null,
getStringFromVariableAttributes("sol_ne")
 == Primeiro_Alarm_Encoder.getStringFromVariableAttributes("sol_ne"),
          perceivedSeverity != PerceivedSeverity.CLEARED) over window:time(15s
       )

       not NotifAlarmCorrelationEvent(
          alarmUniqueKey == segundo_Alarm_Encoder.alarmUniqueKey,
          perceivedSeverity == PerceivedSeverity.CLEARED,
          this after segundo_Alarm_Encoder
       )

       not NotifAlarmCorrelationEvent(
          alarmUniqueKey == segundo_Alarm_Encoder.alarmUniqueKey,
          perceivedSeverity != PerceivedSeverity.CLEARED,
          this before segundo_Alarm_Encoder
       )

       Array_Encoder: ArrayList(Array_Encoder.size() > 1) from accumulate (
          Array_Encoder_pattern: NotifAlarmCorrelationEvent(
             specificProblem != null, specificProblem.contains("SOURCE_VIDEO_UNDERFLOW"),
             managedObjectClass == "CANAL",
             managedObjectInstance != null, managedObjectInstance.matches("ENCODER (.*\\[[0-9:]+\\].*)"
),
             Primeiro_Alarm_Encoder.getStringFromVariableAttributes("sol_ne") != null,
getStringFromVariableAttributes("sol_ne")
 == Primeiro_Alarm_Encoder.getStringFromVariableAttributes("sol_ne")
          ), openEvents(Array_Encoder_pattern)
       )

       not NotifAlarmCorrelationEvent(
          subsystem == "ALMMNG",
          technology == "HE",
          specificProblem == "Several SOURCE_VIDEO_UNDERFLOW",
          Primeiro_Alarm_Encoder.getStringFromVariableAttributes("sol_ne") != null,
getStringFromVariableAttributes("sol_ne")
 == Primeiro_Alarm_Encoder.getStringFromVariableAttributes("sol_ne"),
          perceivedSeverity != PerceivedSeverity.CLEARED
       )

then
    NotifAlarmCorrelationEvent correlacionado = new NotifAlarmCorrelationEvent(segundo_Alarm_Encoder);
    correlacionado.setId(null);

    correlacionado.setAdditionalInfo("Bundle=Encoder||Pack=Encoder HE/HOR||Rule="+drools.getRule().getName());
    correlacionado.setRuleID(getPackId());
    correlacionado.setSubsystem("ALMMNG");
    correlacionado.setTechnology("HE");
    correlacionado.setSpecificProblem("Several SOURCE_VIDEO_UNDERFLOW");
    correlacionado.setPerceivedSeverity(PerceivedSeverity.CRITICAL);

    correlacionado.addChildren(Array_Encoder);
    correlacionado.getMap().putAll(getAlarmUniqueKeys(Array_Encoder));

    insert(correlacionado);
    helper.send(drools.getRule().getName(), correlacionado);
end

rule "SOURCE_VIDEO_UNDERFLOW (close)_106"
no-loop
when
       ROUTECAUSE: NotifAlarmCorrelationEvent(
          specificProblem != null, specificProblem.contains("SOURCE_VIDEO_UNDERFLOW"),
          subsystem == "ALMMNG",
          perceivedSeverity != PerceivedSeverity.CLEARED
       )

       not NotifAlarmCorrelationEvent(
          alarmUniqueKey == ROUTECAUSE.alarmUniqueKey,
          perceivedSeverity == PerceivedSeverity.CLEARED,
          this after ROUTECAUSE
       )

       not NotifAlarmCorrelationEvent(
          perceivedSeverity != PerceivedSeverity.CLEARED,
          alarmUniqueKey == ROUTECAUSE.alarmUniqueKey,
          this after ROUTECAUSE
       )

       ARRAY_Channel: ArrayList(ARRAY_Channel.size() < 2) from accumulate (
          ARRAY_Channel_pattern: NotifAlarmCorrelationEvent(
             subsystem == "HOR",
             technology == "HE",
             specificProblem != null, specificProblem.contains("SOURCE_VIDEO_UNDERFLOW"),
             managedObjectInstance != null, managedObjectInstance.contains(ROUTECAUSE.managedObjectInstance)
          ), openEvents(ARRAY_Channel_pattern)
       )

then
    NotifAlarmCorrelationEvent ROUTECAUSECLEAR = new NotifAlarmCorrelationEvent(ROUTECAUSE);
    ROUTECAUSECLEAR.setId(null);

    ROUTECAUSECLEAR.setAdditionalInfo("Bundle=Encoder||Pack=Encoder HE/HOR||Rule="+drools.getRule().getName());
    ROUTECAUSECLEAR.setRuleID(getPackId());
    ROUTECAUSECLEAR.setPerceivedSeverity(PerceivedSeverity.CLEARED);
    ROUTECAUSECLEAR.setVariableAdditionalText("SOURCE_VIDEO_UNDERFLOW (close)");

    insert(ROUTECAUSECLEAR);
    helper.send(drools.getRule().getName(), ROUTECAUSECLEAR);
end



rule "Automatic Duplicate Removal_106"
salience (500)
no-loop
when
    ORIGINAL: NotifAlarmCorrelationEvent(
        ruleID == getPackId()
    )

    DUPLICATE: NotifAlarmCorrelationEvent(
        ruleID == getPackId(),
        alarmUniqueKey == ORIGINAL.alarmUniqueKey,
        perceivedSeverity == ORIGINAL.perceivedSeverity,
        this after ORIGINAL
    )
then
    retract(ORIGINAL);
end

