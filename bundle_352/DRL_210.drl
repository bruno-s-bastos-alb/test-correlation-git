package pt.ptinovacao.alarmmgr.eventcorrelation.ptc.regrassoltas.pack210

import pt.ptinovacao.alarmmgr.eventcorrelation.common.server.fm.monitor.events.NotifAlarmCorrelationEvent;
import pt.ptinovacao.alarmmgr.eventcorrelation.core.fm.monitor.GenericHelper;
import pt.ptinovacao.alarmmgr.common.shared.fm.monitor.PerceivedSeverity;
import java.util.logging.Logger;
import java.util.*;
import java.lang.*;


import java.util.regex.Pattern;
import java.util.regex.Matcher;

global GenericHelper helper;
global Logger logger;

declare NotifAlarmCorrelationEvent
@role( event )
end

function String extract(String regex, String value) {
    Pattern ptn = Pattern.compile(regex);
    if (value != null) {
        Matcher m = ptn.matcher(value);
        if (m.find()) {
            return m.group(1);
        }
    }

    return "";
}

function Long toLong(Object val){
    Number num;

    if (val instanceof String)
        num = Long.parseLong((String)val);
    else {
        num = (Number) val;
    }

    return num != null ? num.longValue(): null;
}


function Map getAlarmUniqueKeys(List events){
    Map<String, String> result = new HashMap<>();

    if (events != null) {
        for (NotifAlarmCorrelationEvent event : (List<NotifAlarmCorrelationEvent>)events) {
            result.put(event.getAlarmUniqueKey(), "");
        }
    }

    return result;
}

// Pack "performance"
rule "Automatic Clean_1352"
salience (-100)
no-loop
when
    CLEAR: NotifAlarmCorrelationEvent(
        ruleID == getPackId(),
        perceivedSeverity == PerceivedSeverity.CLEARED
    )

    EVENTS_ARRAY: ArrayList(  ) from collect (
        NotifAlarmCorrelationEvent(
            ruleID == getPackId(),
            alarmUniqueKey == CLEAR.alarmUniqueKey,
            this before CLEAR
        )
    )
then
    retract(CLEAR);
    for (NotifAlarmCorrelationEvent a: (List<NotifAlarmCorrelationEvent>)EVENTS_ARRAY ) {
        retract(a);
    }
end

rule "performance_1352"
no-loop
when
       COL: ArrayList(COL.size() >= 2) from collect (
        NotifAlarmCorrelationEvent(
            subsystem == "NOKIA"
        )
    )
       EVENT_1: NotifAlarmCorrelationEvent(
          subsystem == "NOKIA",
          perceivedSeverity != PerceivedSeverity.CLEARED
       )

       not NotifAlarmCorrelationEvent(
          alarmUniqueKey == EVENT_1.alarmUniqueKey,
          perceivedSeverity == PerceivedSeverity.CLEARED,
          this after EVENT_1
       )

       not NotifAlarmCorrelationEvent(
          subsystem == "ALMMNG",
          specificProblem == "CORR"
       )

then
    NotifAlarmCorrelationEvent RC = new NotifAlarmCorrelationEvent(EVENT_1);

    RC.setAdditionalInfo("Bundle=performance||Pack=performance||Rule="+drools.getRule().getName());
    RC.setRuleID(getPackId());
    RC.setSubsystem("ALMMNG");
    RC.setSpecificProblem("CORR");

    insert(RC);
    helper.sendNodeAndHierarchy(drools.getRule().getName(), RC);
end
